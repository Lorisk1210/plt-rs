# plt-rs' modern look, the default style of figures (see `plt::look`).
# Inter type in quiet ink, hairline grids behind the data, no top or right
# spines and no tick marks, left-aligned titles, constrained layout, and a
# categorical palette checked for colour-vision deficiencies.

## Figure: a 16:10 white card with room around its axes
figure.figsize: 7.2, 4.5
figure.facecolor: white
figure.edgecolor: white
figure.titlesize: 14
figure.titleweight: semibold
figure.labelsize: 11
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.0833
figure.constrained_layout.w_pad: 0.0833
# `tight_layout()` leaves these figures to constrained layout.
plt.tight_layout.keep_constrained: True

## Type
font.family: sans-serif
font.sans-serif: Inter, DejaVu Sans, Bitstream Vera Sans, Arial, Helvetica, sans-serif
font.size: 10
text.color: 1f2328
# Math in Inter too (calligraphy in Computer Modern), with the symbols of
# matplotlib's default math: sums, products and integrals at display size
# from DejaVu Sans Display, what else Inter lacks from DejaVu Sans, and
# STIX Sans for the rest.
mathtext.fontset: custom
mathtext.rm: Inter
mathtext.it: Inter:italic
mathtext.bf: Inter:bold
mathtext.bfit: Inter:italic:bold
mathtext.sf: Inter
mathtext.cal: cmsy10
mathtext.fallback: stixsans
plt.mathtext.dejavu_symbols: True

## Axes: no frame, a light baseline, the grid below the data
axes.facecolor: white
axes.edgecolor: d0d5dd
axes.linewidth: 0.8
axes.grid: True
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
axes.titlesize: 12
axes.titleweight: semibold
axes.titlelocation: left
axes.titlepad: 10
axes.labelsize: 10.5
axes.labelcolor: 606873
axes.labelpad: 6
# Blue, orange, aqua, yellow, magenta, green, violet, red: every adjacent
# pair stays apart for protan, deutan and tritan vision.
axes.prop_cycle: cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '31983d', '6250d6', 'e34948'])
# Twins leave the grid to the axes they twin: theirs would cross its data.
plt.axes.twin_grid: False
# Insets over data get all four spines, to stand apart from it.
plt.inset.frame: True

grid.color: e5e7eb
grid.linestyle: -
grid.linewidth: 0.8
# Images lie below even lowered gridlines: they turn the grid off.
plt.image.hide_grid: True

## Ticks: labels only, the grid marks the positions
xtick.color: 606873
xtick.major.size: 0
xtick.minor.size: 0
xtick.major.pad: 6
ytick.color: 606873
ytick.major.size: 0
ytick.minor.size: 0
ytick.major.pad: 6

## 3-D axes: panes in the greys of the chrome
axes3d.xaxis.panecolor: f9fafb
axes3d.yaxis.panecolor: f3f4f6
axes3d.zaxis.panecolor: f6f7f9

## Marks: the edges of patches (annotation arrows, text boxes) in ink
patch.edgecolor: 1f2328
lines.linewidth: 1.75
lines.solid_capstyle: round
boxplot.boxprops.color: 4b5563
boxplot.whiskerprops.color: 4b5563
boxplot.capprops.color: 4b5563
boxplot.flierprops.markeredgecolor: 4b5563

## What matplotlib draws in black (arrows, barbs, size bars, ...) in ink;
## tables and boxes in hairlines
plt.ink: 1f2328
plt.table.facecolor: white
plt.table.edgecolor: d0d5dd
plt.offsetbox.facecolor: white
plt.offsetbox.edgecolor: d0d5dd

## Widgets: framed like the controls of the window around the figure
plt.widgets.frame: True
plt.widgets.button.color: white
plt.widgets.button.hovercolor: f3f4f6
plt.widgets.textbox.color: white
plt.widgets.textbox.hovercolor: f6f7f9
plt.widgets.radiobuttons.activecolor: 2a78d6
plt.widgets.slider.track_color: e5e7eb
plt.widgets.slider.initcolor: 9ca3af

## Legend: no box, the swatches carry identity
legend.frameon: False
legend.fontsize: 9.5
legend.title_fontsize: 10
legend.handlelength: 1.6
