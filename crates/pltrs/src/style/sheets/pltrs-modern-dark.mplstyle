# pltrs' modern look on a charcoal background (see `pltrs::look`): the
# `pltrs-modern` sheet with light ink, and the same palette stepped for the
# dark surface.

## Figure: a 16:10 charcoal card with room around its axes
figure.figsize: 7.2, 4.5
figure.facecolor: 1e2024
figure.edgecolor: 1e2024
figure.titlesize: 14
figure.titleweight: semibold
figure.labelsize: 11
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.0833
figure.constrained_layout.w_pad: 0.0833
# `tight_layout()` leaves these figures to constrained layout.
pltrs.tight_layout.keep_constrained: True

## Type
font.family: sans-serif
font.sans-serif: Inter, DejaVu Sans, Bitstream Vera Sans, Arial, Helvetica, sans-serif
font.size: 10
text.color: e6e9ed
# Math in Inter too (calligraphy in Computer Modern), with the symbols of
# matplotlib's default math: sums, products and integrals at display size
# from DejaVu Sans Display, what else Inter lacks from DejaVu Sans, and
# STIX Sans for the rest.
mathtext.fontset: custom
mathtext.rm: Inter
mathtext.it: Inter:italic
mathtext.bf: Inter:bold
mathtext.bfit: Inter:italic:bold
mathtext.sf: Inter
mathtext.cal: cmsy10
mathtext.fallback: stixsans
pltrs.mathtext.dejavu_symbols: True

## Axes: no frame, a light baseline, the grid below the data
axes.facecolor: 1e2024
axes.edgecolor: 464b53
axes.linewidth: 0.8
axes.grid: True
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
axes.titlesize: 12
axes.titleweight: semibold
axes.titlelocation: left
axes.titlepad: 10
axes.labelsize: 10.5
axes.labelcolor: 9ea6b0
axes.labelpad: 6
# Blue, orange, aqua, yellow, magenta, green, violet, red: every adjacent
# pair stays apart for protan, deutan and tritan vision.
axes.prop_cycle: cycler('color', ['3987e5', 'd95926', '199e70', 'c98500', 'd55181', '57bb5e', '9085e9', 'e66767'])
# Twins leave the grid to the axes they twin: theirs would cross its data.
pltrs.axes.twin_grid: False
# Insets over data get all four spines, to stand apart from it.
pltrs.inset.frame: True

grid.color: 33373d
grid.linestyle: -
grid.linewidth: 0.8
# Images lie below even lowered gridlines: they turn the grid off.
pltrs.image.hide_grid: True

## Ticks: labels only, the grid marks the positions
xtick.color: 9ea6b0
xtick.major.size: 0
xtick.minor.size: 0
xtick.major.pad: 6
ytick.color: 9ea6b0
ytick.major.size: 0
ytick.minor.size: 0
ytick.major.pad: 6

## 3-D axes: panes a step above the background
axes3d.xaxis.panecolor: 25282d
axes3d.yaxis.panecolor: 2b2e34
axes3d.zaxis.panecolor: 282b30

## Marks: the edges of patches (annotation arrows, text boxes) in ink
patch.edgecolor: e6e9ed
lines.linewidth: 1.75
lines.solid_capstyle: round
boxplot.boxprops.color: 9ea6b0
boxplot.whiskerprops.color: 9ea6b0
boxplot.capprops.color: 9ea6b0
boxplot.flierprops.markeredgecolor: 9ea6b0

## What matplotlib draws in black (arrows, barbs, size bars, ...) in ink;
## tables and boxes in hairlines
pltrs.ink: e6e9ed
pltrs.table.facecolor: 1e2024
pltrs.table.edgecolor: 464b53
pltrs.offsetbox.facecolor: 1e2024
pltrs.offsetbox.edgecolor: 464b53

## Widgets: framed like the controls of the window around the figure
pltrs.widgets.frame: True
pltrs.widgets.button.color: 30343a
pltrs.widgets.button.hovercolor: 393d44
pltrs.widgets.textbox.color: 282b30
pltrs.widgets.textbox.hovercolor: 30343a
pltrs.widgets.radiobuttons.activecolor: 3987e5
pltrs.widgets.slider.track_color: 33373d
pltrs.widgets.slider.initcolor: 6b7280

## Legend: no box, the swatches carry identity
legend.frameon: False
legend.fontsize: 9.5
legend.title_fontsize: 10
legend.handlelength: 1.6
