{
 "area": "mpl_text",
 "matplotlib": "3.11.2",
 "probes": [
  {"op": "Figure.stale", "args": {}, "value": [false, true, true, false]},
  {"op": "FontProperties.get_size_in_points", "args": {"size": "large", "base": 10, "later": 100}, "value": 12.0},
  {"op": "FontProperties.get_size_in_points", "args": {"size": "x-small", "base": 10, "later": 100}, "value": 6.9399999999999995},
  {"op": "FontProperties.get_size_in_points", "args": {"size": 14, "base": 10, "later": 100}, "value": 14.0},
  {"op": "Text.get_math_fontfamily", "args": {"rc": {"mathtext.fontset": "cm"}, "font": "Arial", "math_fontfamily": "dejavusans"}, "value": "dejavusans"},
  {"op": "Text.get_math_fontfamily", "args": {"rc": {"mathtext.fontset": "cm"}, "font": "Arial"}, "value": "cm"},
  {
   "op": "Text.get_math_fontfamily",
   "args": {"rc": {"mathtext.fontset": "cm"}, "font": "DejaVu Serif:bold", "math_fontfamily": "dejavusans"},
   "value": "dejavusans"
  },
  {"op": "Text.get_math_fontfamily", "args": {"rc": {"mathtext.fontset": "cm"}, "font": "DejaVu Serif:bold"}, "value": "cm"},
  {"op": "mathtext.math_to_image", "args": {"s": "$x^2$", "color": "Maroon"}, "value": [1.0, 16, 19]},
  {"op": "mathtext.math_to_image", "args": {"s": "$\\frac{a}{b}\\,y_i$"}, "value": [5.0, 18, 25]},
  {"op": "mathtext.math_to_image", "args": {"s": "$x^2$"}, "value": [1.0, 16, 19]}
 ]
}
