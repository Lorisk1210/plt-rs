#!/usr/bin/env bash
# Run the conformance spec against real matplotlib.
#   spec/mpl-reference                   verify goldens reproduce exactly
#   spec/mpl-reference --update-goldens  regenerate goldens from matplotlib
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root/spec/reference"
python="$root/.venv/bin/python"
# A venv on Windows (under MSYS2's or Git for Windows' bash) keeps its
# interpreter in Scripts.
[ -e "$python" ] || python="$root/.venv/Scripts/python.exe"
exec "$python" -m pytest "$@"
